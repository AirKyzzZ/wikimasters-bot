# Copy to .env (CLI), ~/.config/wmbot/env (systemd), or pass with --env-file.
# Everything is optional. Never put your refresh token here, use `wmbot login`.

# Where the rotating session lives (chmod 600, created by `wmbot login`).
# WM_SESSION_FILE=~/.secrets/wikimasters.session.json

# pulls.jsonl, state.json and reports/ go here.
# WM_DATA_DIR=~/.local/share/wmbot

# Posts the daily report and fatal alerts. Treat this URL as a secret.
# WM_DISCORD_WEBHOOK=https://discord.com/api/webhooks/...

# Public Supabase anon key. Found automatically on the site when empty.
# WM_ANON_KEY=

# Set to 0 to stop writing yesterday's report automatically.
# WM_AUTO_REPORT=1

# Report days follow the system timezone. Override it with the standard variable.
# TZ=Europe/Paris
